# ------------------------------------------------------------
# YouTube Music Integration
# ------------------------------------------------------------
# Dedicated Sonora Audio Service endpoint. This service runs yt-dlp + ffmpeg
# outside Vercel and streams 128 kbps MP3 bytes to Sonora.
SONORA_AUDIO_API_URL=
# Optional Bearer token shared between Sonora and the audio service.
SONORA_AUDIO_API_KEY=

# ------------------------------------------------------------
# Playlist import (Spotify)
# ------------------------------------------------------------
# Create a Spotify developer app, enable Web API, and allow the exact
# callback URL below in its dashboard. Current development apps require
# Spotify Premium and only expose owned/collaborative playlist contents.
# Users connect Spotify in the import window (read-only playlist scopes).
# PKCE handles authorization without any client secret.
# YouTube Music public playlists need no extra setup.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://your-sonora-host/api/spotify/callback
