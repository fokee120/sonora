# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Cloud Storage Credentials (Private bucket for MP3/M4A audio)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Access Control: Comma-separated list of approved emails (e.g., user@example.com)
AUTHORIZED_EMAILS=fokee83@gmail.com

# Optional Session Secret
AUTH_SECRET=personal-music-secret-key-change-in-prod

# ------------------------------------------------------------
# YouTube Music Integration
# ------------------------------------------------------------
# Third-party downloader API endpoint (Cobalt-compatible instance).
# Leave empty to use the built-in audio stream fallback.
# Can also be configured at runtime in Settings > YouTube Music Integration.
COBALT_API_URL=
# Optional API key if your Cobalt instance requires one
COBALT_API_KEY=
# Preferred audio format for downloads: mp3 | opus | best
YT_DOWNLOADER_AUDIO_FORMAT=mp3
# Optional comma-separated Piped-compatible APIs used as resolver fallback
# when YouTube bot-blocks the server's own stream resolution.
PIPED_API_URL=
