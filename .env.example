# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Cloud Storage Credentials (Private bucket for MP3/M4A audio)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Access Control: Comma-separated list of approved emails (e.g., user@example.com)
AUTHORIZED_EMAILS=fokee83@gmail.com

# Optional Session Secret
AUTH_SECRET=personal-music-secret-key-change-in-prod

# ------------------------------------------------------------
# YouTube Music Integration
# ------------------------------------------------------------
# Dedicated Sonora Audio Service endpoint. This service runs yt-dlp + ffmpeg
# outside Vercel and streams 128 kbps MP3 bytes to Sonora.
SONORA_AUDIO_API_URL=
# Optional Bearer token shared between Sonora and the audio service.
SONORA_AUDIO_API_KEY=
